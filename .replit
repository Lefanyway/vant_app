modules = ["nodejs-24"]

[nix]
channel = "stable-25_05"

[[ports]]
localPort = 5000
externalPort = 80

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "sequential"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash scripts/project.sh"

[deployment]
deploymentTarget = "vm"
build = ["bash", "-lc", "pnpm install --frozen-lockfile && node scripts/build-production.mjs"]
run = ["node", "scripts/start-production.mjs"]
